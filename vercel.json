{
  "rewrites": [
    { "source": "/admin",          "destination": "/admin.html" },
    { "source": "/auth",           "destination": "/auth.html" },
    { "source": "/account",        "destination": "/account.html" },
    { "source": "/beauty-profile", "destination": "/beauty-profile.html" },
    { "source": "/success",        "destination": "/success.html" },
    { "source": "/cancel",         "destination": "/cancel.html" },
    { "source": "/contact",        "destination": "/contact.html" },
    { "source": "/privacy",        "destination": "/privacy.html" },
    { "source": "/returns",        "destination": "/returns.html" },
    { "source": "/404",            "destination": "/404.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://storage.googleapis.com; connect-src 'self' https://firestore.googleapis.com https://storage.googleapis.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ]
}
